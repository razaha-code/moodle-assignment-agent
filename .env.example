OPENAI_API_KEY=your_openai_api_key
MOODLE_TOKEN=your_moodle_webservice_token
MOODLE_BASE_URL=https://moodle.bgu.ac.il/moodle
MOODLE_SERVICE=moodle_mobile_app
MOODLE_TIMEZONE=Asia/Jerusalem
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MIN_REQUEST_INTERVAL_SECONDS=0.25
OPENAI_TOKEN_SAFETY_RESERVE=30000
MOODLE_ACTIVE_COURSE_IDS=65610,64359,65397,64403,65602,64408

# OPENAI_MODEL is the classifier model and the fallback for agents whose TOML omits `model`.
# Per-agent provider/model/temperature settings live in agents/*.toml.

# The CLI defaults to three concurrent assignment workers. Override per run with --max-workers.
# Each worker owns its Moodle/OpenAI HTTP sessions.

# Optional fallback if MOODLE_TOKEN is not set:
MOODLE_USERNAME=your_username
MOODLE_PASSWORD=your_password

# Optional: after a successful bootstrap run, the workflow can save
# MOODLE_TOKEN here automatically when you use --bootstrap-token --save-token.
